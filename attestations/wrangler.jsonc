{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maple-attestations",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "attestations.trymaple.ai",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
}
